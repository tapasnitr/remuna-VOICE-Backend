{
  "name": "remuna-voice-server",
  "version": "1.0.0",
  "description": "Voice Management System",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "build:client": "cd client && npm run build",
    "build:server": "tsc",
    "build": "npm run build:client && npm run build:server",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "prisma:pull:local": "dotenv -e .env.local -- prisma db pull",
    "prisma:pull:prod": "dotenv -e .env.prod -- prisma db pull",
    "prisma:generate:local": "dotenv -e .env.local -- prisma generate",
    "prisma:generate:prod": "dotenv -e .env.prod -- prisma generate",
    "prisma:sync:local": "dotenv -e .env.local -- prisma db pull && dotenv -e .env.local -- prisma generate",
    "prisma:sync:prod": "dotenv -e .env.prod -- prisma db pull && dotenv -e .env.prod -- prisma generate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krishnastapas/remuna-VOICE-Backend.git"
  },
  "author": "Astrared Software Labs Pvt Ltd",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/krishnastapas/remuna-VOICE-Backend/issues"
  },
  "homepage": "https://github.com/krishnastapas/remuna-VOICE-Backend#readme",
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^5.22.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "next": "^16.1.6",
    "pg": "^8.18.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.2.2",
    "@types/pg": "^8.16.0",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^11.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
